  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# 03 - Final Inference\n",
        "Applies the fully trained and verified classifier to the remaining, unseen dataset."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import os\n",
        "from pathlib import Path\n",
        "import sys\n",
        "\n",
        "# --- ENVIRONMENT SWITCH ---\n",
        "RUNNING_LOCALLY = False\n",
        "\n",
        "if RUNNING_LOCALLY:\n",
        "    _REPO_ROOT = str(Path(os.getcwd()).resolve().parents[1])\n",
        "    if _REPO_ROOT not in sys.path:\n",
        "        sys.path.insert(0, _REPO_ROOT)\n",
        "    BASE_PATH = Path('/Volumes/GoogleDrive/My Drive/Colab Projects/AI Public Trust')\n",
        "else:\n",
        "    from google.colab import drive\n",
        "    drive.mount('/content/drive')\n",
        "    BASE_PATH = Path('/content/drive/My Drive/Colab Projects/AI Public Trust')\n",
        "\n",
        "test_folder       = BASE_PATH / 'Raw Data/'\n",
        "datasets_folder   = BASE_PATH / 'Data Sets'\n",
        "cleanedds_folder  = BASE_PATH / 'Data Sets/Cleaned Data'\n",
        "hitl_folder       = datasets_folder / 'Classifiers_Data' / 'HITL'\n",
        "out_folder        = datasets_folder / 'Classifiers_Data' / 'Final'\n",
        "out_folder.mkdir(parents=True, exist_ok=True)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import os\n",
        "if not RUNNING_LOCALLY:\n",
        "    print('Running Colab setup shell commands...')\n",
        "    !pip install -q transformers torch \n",
        "else:\n",
        "    print('Running locally: Skipping Colab shell setup.')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import time\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import torch\n",
        "from transformers import AutoTokenizer, AutoModelForSequenceClassification, pipeline"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 1. Load the Best Model\n",
        "Loads the serialized RoBERTa model from the last HITL iteration."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "best_model_path = hitl_folder / 'best_roberta_model'\n",
        "\n",
        "if not best_model_path.exists():\n",
        "    raise FileNotFoundError('No trained model found! Ensure 02_hitl_training_loop.ipynb finished properly.')\n",
        "\n",
        "print('Loading Best Model...')\n",
        "tokenizer = AutoTokenizer.from_pretrained(str(best_model_path))\n",
        "model = AutoModelForSequenceClassification.from_pretrained(str(best_model_path))\n",
        "device = 0 if torch.cuda.is_available() else -1\n",
        "\n",
        "pipe = pipeline('text-classification', model=model, tokenizer=tokenizer, device=device, return_all_scores=True)\n",
        "print('Model successfully loaded into inference pipeline.')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 2. Load Final Inference Dataset"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "inference_path = hitl_folder / 'inference_dataset.pkl'\n",
        "df = pd.read_pickle(inference_path)\n",
        "print(f'Loaded inference dataset: {len(df)} tweets to process.')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 3. Run Inference\n",
        "We push the entire dataset through the model in chunks."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "t0 = time.time()\n",
        "chunk_size = 500\n",
        "all_preds = []\n",
        "\n",
        "for i in range(0, len(df), chunk_size):\n",
        "    texts = df['text'].iloc[i:i+chunk_size].astype(str).tolist()\n",
        "    scores = pipe(texts)\n",
        "    all_preds.extend(scores)\n",
        "    \n",
        "    if i > 0 and i % 50_000 == 0:\n",
        "        print(f'Processed {i}/{len(df)}... ({time.time() - t0:.2f}s elapsed)')\n",
        "\n",
        "print(f'\\nTotal Inference Time for {len(df)} tweets: {time.time() - t0:.2f} seconds')\n",
        "\n",
        "pred_labels = []\n",
        "pred_confidences = []\n",
        "for score_list in all_preds:\n",
        "    best_class = max(score_list, key=lambda x: x['score'])\n",
        "    pred_labels.append(best_class['label'])\n",
        "    pred_confidences.append(best_class['score'])\n",
        "    \n",
        "df['predicted_label'] = pred_labels\n",
        "df['confidence'] = pred_confidences"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 4. Compile and Save Final Dataset\n",
        "Combines the Human-labeled data from HITL with this final inferred dataset into the ultimate database for Network/Topic Analysis."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import glob\n",
        "\n",
        "# 1. Load all human-labeled review batches\n",
        "labeled_files = sorted(glob.glob(str(hitl_folder / 'hitl_review_batch_*.csv')))\n",
        "hitl_dfs = []\n",
        "for f in labeled_files:\n",
        "    temp_df = pd.read_csv(f)\n",
        "    if 'human_label' in temp_df.columns:\n",
        "        # For final data, the predicted_label is overwritten by the true human_label\n",
        "        temp_df['predicted_label'] = temp_df['human_label'].fillna(temp_df['predicted_label'])\n",
        "        temp_df = temp_df.dropna(subset=['human_label'])\n",
        "        hitl_dfs.append(temp_df)\n",
        "\n",
        "if hitl_dfs:\n",
        "    all_human_df = pd.concat(hitl_dfs, ignore_index=True)\n",
        "    all_human_df['is_human_labeled'] = True\n",
        "else:\n",
        "    all_human_df = pd.DataFrame()\n",
        "\n",
        "df['human_label'] = np.nan\n",
        "df['is_human_labeled'] = False\n",
        "\n",
        "# 2. Combine\n",
        "final_df = pd.concat([df, all_human_df], ignore_index=True)\n",
        "print(f'Total size of final combined dataset: {len(final_df)} tweets')\n",
        "\n",
        "# 3. Save\n",
        "final_pkl = out_folder / 'final_annotated_tweets.pkl'\n",
        "final_csv = out_folder / 'final_annotated_tweets.csv'\n",
        "\n",
        "final_df.to_pickle(final_pkl)\n",
        "final_df.to_csv(final_csv, index=False)\n",
        "print(f'Final fully annotated dataset saved to {final_csv}')"
      ]
    }
  ],
