{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# 01 - HITL Data Preparation\n",
        "Splits the cleaned dataset for Active Learning annotation."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import os\n",
        "from pathlib import Path\n",
        "import sys\n",
        "\n",
        "# --- ENVIRONMENT SWITCH ---\n",
        "# Set to True if running on local machine with Google Drive Desktop mounted\n",
        "# Set to False if running in Google Colab cloud\n",
        "RUNNING_LOCALLY = False\n",
        "\n",
        "if RUNNING_LOCALLY:\n",
        "    # --- REPO ROOT ON sys.path (so `from src.*` works locally) ---\n",
        "    _REPO_ROOT = str(Path(os.getcwd()).resolve().parents[1])\n",
        "    if _REPO_ROOT not in sys.path:\n",
        "        sys.path.insert(0, _REPO_ROOT)\n",
        "    # Standard macOS path for Google Drive Desktop\n",
        "    BASE_PATH = Path('/Volumes/GoogleDrive/My Drive/Colab Projects/AI Public Trust')\n",
        "\n",
        "else:\n",
        "    # Google Colab cloud path\n",
        "    from google.colab import drive\n",
        "    drive.mount('/content/drive')\n",
        "    BASE_PATH = Path('/content/drive/My Drive/Colab Projects/AI Public Trust')\n",
        "\n",
        "# Pre-compute critical paths used across notebooks\n",
        "twits_folder      = BASE_PATH / 'Raw Data/Twits/'\n",
        "test_folder       = BASE_PATH / 'Raw Data/'\n",
        "datasets_folder   = BASE_PATH / 'Data Sets'\n",
        "cleanedds_folder  = BASE_PATH / 'Data Sets/Cleaned Data'\n",
        "networks_folder   = BASE_PATH / 'Data Sets/Networks/'\n",
        "literature_folder = BASE_PATH / 'Literature/'\n",
        "topic_models_folder = BASE_PATH / 'Models/Topic Modeling/'"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import os\n",
        "if not RUNNING_LOCALLY:\n",
        "    print('Running Colab setup shell commands...')\n",
        "    # Add pip installs if needed\n",
        "else:\n",
        "    print('Running locally: Skipping Colab shell setup.')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import os\n",
        "import json\n",
        "import random\n",
        "import pickle\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from pathlib import Path\n",
        "from datetime import datetime, timezone"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Load the cleaned dataset\n",
        "# Ensure the file name matches your clean exported data from 03_cleaning_tweets.ipynb\n",
        "CLEANED_DATA_PATH = cleanedds_folder / 'cleaned_tweets.pkl' # Update extension to .csv if necessary\n",
        "\n",
        "print(f'Loading data from {CLEANED_DATA_PATH}...')\n",
        "if CLEANED_DATA_PATH.suffix == '.pkl':\n",
        "    df = pd.read_pickle(CLEANED_DATA_PATH)\n",
        "elif CLEANED_DATA_PATH.suffix == '.csv':\n",
        "    df = pd.read_csv(CLEANED_DATA_PATH)\n",
        "else:\n",
        "    raise ValueError('Unknown file format')\n",
        "\n",
        "print(f'Loaded {len(df)} total tweets.')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Extract required columns and ensure format\n",
        "# Assuming our base df has columns like id, text, public_metrics, etc.\n",
        "if 'public_metrics.like_count' in df.columns:\n",
        "    df['likes'] = df['public_metrics.like_count']\n",
        "    df['retweets'] = df['public_metrics.retweet_count']\n",
        "elif 'like_count' in df.columns:\n",
        "    df['likes'] = df['like_count']\n",
        "    df['retweets'] = df['retweet_count']\n",
        "else:\n",
        "    # fallback\n",
        "    df['likes'] = 0\n",
        "    df['retweets'] = 0\n",
        "\n",
        "if 'tweet_id' in df.columns:\n",
        "    df['id'] = df['tweet_id']\n",
        "\n",
        "required_cols = ['id', 'text', 'likes', 'retweets']\n",
        "available_cols = [c for c in required_cols if c in df.columns]\n",
        "df = df[available_cols].copy()\n",
        "df['predicted_label'] = np.nan\n",
        "df['human_label'] = np.nan\n",
        "\n",
        "# Shuffle the data completely\n",
        "df = df.sample(frac=1, random_state=42).reset_index(drop=True)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Partition the Data\n",
        "# 1. Base Dataset (100k)\n",
        "# 2. HITL Dataset (200k into 4 x 50k)\n",
        "# 3. Final Inference Dataset (The rest)\n",
        "\n",
        "base_size = 100_000\n",
        "hitl_size = 200_000\n",
        "\n",
        "if len(df) < base_size + hitl_size:\n",
        "    print('Warning: Dataset is smaller than the requested base+HITL size. We will partition proportionally.')\n",
        "    base_size = min(len(df), base_size)\n",
        "    hitl_size = min(len(df) - base_size, hitl_size)\n",
        "\n",
        "base_df = df.iloc[:base_size].copy()\n",
        "hitl_df = df.iloc[base_size:base_size+hitl_size].copy()\n",
        "inference_df = df.iloc[base_size+hitl_size:].copy()\n",
        "\n",
        "print(f'Base size: {len(base_df)}')\n",
        "print(f'HITL size: {len(hitl_df)}')\n",
        "print(f'Final Inference size: {len(inference_df)}')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Save partitions to disk\n",
        "hitl_folder = datasets_folder / 'Classifiers_Data' / 'HITL'\n",
        "hitl_folder.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "# Note: Using pickle for fast binary I/O, except when handing off to humans\n",
        "base_df.to_pickle(hitl_folder / 'base_dataset.pkl')\n",
        "inference_df.to_pickle(hitl_folder / 'inference_dataset.pkl')\n",
        "\n",
        "# Split HITL into 4 batches of 50k\n",
        "batch_size = 50_000\n",
        "total_batches = int(np.ceil(len(hitl_df) / batch_size))\n",
        "for i in range(total_batches):\n",
        "    start = i * batch_size\n",
        "    end = start + batch_size\n",
        "    batch_df = hitl_df.iloc[start:end]\n",
        "    if len(batch_df) > 0:\n",
        "        batch_path = hitl_folder / f'hitl_pending_batch_{i+1:02d}.pkl'\n",
        "        batch_df.to_pickle(batch_path)\n",
        "        print(f'Saved {batch_path.name} with {len(batch_df)} tweets.')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Extract 1st Review Batch\n",
        "# Since we have no model yet, we extract exactly 10,000 completely random tweets from the base dataset.\n",
        "print('Extracting initial 10,000 random tweets for Ground Truth labeling...')\n",
        "\n",
        "first_review_batch = base_df.sample(n=min(len(base_df), 10000), random_state=42)\n",
        "\n",
        "# Clean text to ensure CSV is readable (remove newlines in text)\n",
        "if 'text' in first_review_batch.columns:\n",
        "    first_review_batch['text'] = first_review_batch['text'].astype(str).str.replace('\\n', ' ', regex=False).str.replace('\\r', '', regex=False)\n",
        "\n",
        "# Save to CSV for human labeling\n",
        "batch_output_path = hitl_folder / 'hitl_review_batch_00.csv'\n",
        "first_review_batch.to_csv(batch_output_path, index=False)\n",
        "print(f'Exported initial review batch to: {batch_output_path}')\n",
        "print(f'Please manually label the \\'human_label\\' column for these {len(first_review_batch)} rows and place the finished CSV into the HITL folder.')"
      ]
    }
  ],
